<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odashboard</field>
        <field name="model">res.config.settings</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ODashboard" string="ODashboard" name="odashboard" logo="/odashboard_v2/static/description/icon.png">
                    <block title="ODashboard Connection" name="odashboard_connection">
                        <setting string="API URL" help="The ODashboard API server URL">
                            <field name="odashboard_api_url" placeholder="https://api.odashboard.io"/>
                        </setting>
                        <setting string="App URL" help="The ODashboard web application URL">
                            <field name="odashboard_frontend_url" placeholder="https://app.odashboard.io"/>
                        </setting>
                        <setting string="Instance Key" help="Copy it from your ODashboard instance settings">
                            <field name="odashboard_instance_key" password="True"/>
                        </setting>
                        <setting string="Connection Status">
                            <field name="odashboard_sync_status" widget="badge"
                                   decoration-success="odashboard_sync_status == 'connected'"
                                   decoration-warning="odashboard_sync_status == 'pending'"
                                   decoration-muted="odashboard_sync_status == 'not_configured'"
                                   readonly="1"/>
                            <button name="action_odashboard_sync"
                                    string="Synchronize"
                                    type="object"
                                    class="btn-primary ms-2"
                                    invisible="not odashboard_api_url or not odashboard_instance_key"/>
                        </setting>
                    </block>

                    <block title="Danger Zone" name="odashboard_danger_zone"
                           invisible="not odashboard_instance_key and odashboard_sync_status == 'not_configured'">
                        <setting string="Disconnect ODashboard"
                                 help="Deletes the instance key and the default API key. The connection with ODashboard will be interrupted.">
                            <div class="text-muted mb-2">
                                This action will delete the configured instance key and the default API key used by ODashboard to communicate with this Odoo database. You will need to reconfigure the connection to use ODashboard again.
                            </div>
                            <button name="action_odashboard_disconnect"
                                    string="Disconnect"
                                    type="object"
                                    class="btn-danger"
                                    confirm="Are you sure you want to disconnect ODashboard? The default API key will be deleted."
                                    invisible="not odashboard_instance_key"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
