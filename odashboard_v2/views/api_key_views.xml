<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View -->
    <record id="view_odashboard_api_key_list" model="ir.ui.view">
        <field name="name">odashboard.api.key.list</field>
        <field name="model">odashboard.api.key</field>
        <field name="arch" type="xml">
            <list string="Clés API" decoration-info="key_type == 'default'">
                <field name="name"/>
                <field name="key_type" widget="badge" 
                       decoration-info="key_type == 'default'" 
                       decoration-muted="key_type == 'custom'"/>
                <field name="user_id"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_used"/>
                <field name="usage_count"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_odashboard_api_key_form" model="ir.ui.view">
        <field name="name">odashboard.api.key.form</field>
        <field name="model">odashboard.api.key</field>
        <field name="arch" type="xml">
            <form string="Clé API">
                <header>
                    <button name="regenerate_key" 
                            string="Régénérer la clé" 
                            type="object" 
                            class="btn-secondary" 
                            invisible="key_type == 'default'"
                            confirm="Êtes-vous sûr de vouloir régénérer cette clé API ? L'ancienne clé cessera de fonctionner immédiatement."/>
                </header>
                <sheet>
                    <!-- Banner for default keys -->
                    <div class="alert alert-warning mb-3" role="alert" invisible="key_type != 'default'">
                        <i class="fa fa-lock me-2"/>
                        <strong>Ceci est la clé API par défaut gérée par ODashboard.</strong>
                        <br/>
                        Cette clé est automatiquement créée et renouvelée lors de la synchronisation.
                        Elle ne peut pas être modifiée ni consultée pour des raisons de sécurité.
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nom de la clé API" readonly="key_type == 'default'"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="key_type" readonly="1" widget="badge"/>
                            <!-- Show masked key for default, real key for custom -->
                            <field name="key_display" string="Clé API" 
                                   widget="CopyClipboardChar" 
                                   invisible="key_type == 'default'"/>
                            <field name="key_display" string="Clé API" 
                                   invisible="key_type != 'default'"
                                   readonly="1"/>
                            <field name="active" readonly="key_type == 'default'"/>
                            <field name="user_id" readonly="key_type == 'default'"/>
                        </group>
                        <group>
                            <field name="last_used"/>
                            <field name="usage_count"/>
                        </group>
                    </group>
                    
                    <!-- Access control — only for custom keys -->
                    <group string="Contrôle d'accès" invisible="key_type == 'default'">
                        <field name="allowed_models" 
                               placeholder="ex : sale.order,res.partner (laisser vide pour tout autoriser)"/>
                    </group>
                    
                    <!-- Usage instructions — only for custom keys -->
                    <group string="Instructions d'utilisation" invisible="key_type == 'default'">
                        <div class="alert alert-info" role="alert">
                            <p><strong>Comment utiliser cette clé API :</strong></p>
                            <p>Ajoutez l'en-tête suivant à vos requêtes HTTP :</p>
                            <code>Authorization: Bearer VOTRE_CLE_API</code>
                            <br/><br/>
                            <p><strong>Endpoints disponibles :</strong></p>
                            <ul>
                                <li><code>GET /odashboard/schema</code> — Obtenir le schéma de la base de données</li>
                                <li><code>POST /odashboard/query</code> — Exécuter des requêtes SELECT</li>
                            </ul>
                        </div>
                    </group>
                    
                    <!-- Hidden fields -->
                    <field name="key" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_odashboard_api_key" model="ir.actions.act_window">
        <field name="name">Clés API</field>
        <field name="res_model">odashboard.api.key</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_key_type': 'custom'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Créez votre première clé API
            </p>
            <p>
                Les clés API sont utilisées pour authentifier les requêtes ODashboard.
            </p>
            <p>
                <strong>Clé par défaut :</strong> Gérée automatiquement par ODashboard lors de la synchronisation.
                Elle ne peut être ni consultée ni modifiée.
            </p>
            <p>
                <strong>Clés personnalisées :</strong> Créez des clés supplémentaires pour des utilisateurs
                ou applications spécifiques, avec des restrictions de modèles optionnelles.
            </p>
        </field>
    </record>

    <!-- Client Action: ODashboard Iframe -->
    <record id="action_odashboard_iframe" model="ir.actions.client">
        <field name="name">ODashboard</field>
        <field name="tag">odashboard_iframe</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_odashboard_root"
              name="ODashboard"
              sequence="100"
              action="action_odashboard_iframe"
              web_icon="odashboard_v2,static/description/icon.png"/>

    <menuitem id="menu_odashboard_config"
              name="Configuration"
              parent="menu_odashboard_root"
              sequence="90"/>

    <menuitem id="menu_odashboard_api_keys"
              name="Clés API"
              parent="menu_odashboard_config"
              action="action_odashboard_api_key"
              sequence="10"/>
</odoo>
