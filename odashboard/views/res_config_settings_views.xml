<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odashboard</field>
        <field name="model">res.config.settings</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="ODashboard" string="ODashboard" name="odashboard" logo="/odashboard/static/description/icon.png">
                    <block title="Connexion ODashboard" name="odashboard_connection">
                        <setting string="URL de l'API" help="L'URL du serveur API ODashboard">
                            <field name="odashboard_api_url" placeholder="https://api.odashboard.io"/>
                        </setting>
                        <setting string="URL de l'application" help="L'URL de l'application web ODashboard">
                            <field name="odashboard_frontend_url" placeholder="https://app.odashboard.io"/>
                        </setting>
                        <setting string="Clé d'instance" help="Copiez-la depuis les paramètres de votre instance ODashboard">
                            <field name="odashboard_instance_key" password="True"/>
                        </setting>
                        <setting string="État de la connexion">
                            <field name="odashboard_sync_status" widget="badge"
                                   decoration-success="odashboard_sync_status == 'connected'"
                                   decoration-warning="odashboard_sync_status == 'pending'"
                                   decoration-muted="odashboard_sync_status == 'not_configured'"
                                   readonly="1"/>
                            <button name="action_odashboard_sync"
                                    string="Synchroniser"
                                    type="object"
                                    class="btn-primary ms-2"
                                    invisible="not odashboard_api_url or not odashboard_instance_key"/>
                        </setting>
                    </block>

                    <block title="Zone de danger" name="odashboard_danger_zone"
                           invisible="not odashboard_instance_key and odashboard_sync_status == 'not_configured'">
                        <setting string="Déconnecter ODashboard"
                                 help="Supprime la clé d'instance et la clé API par défaut. La connexion avec ODashboard sera interrompue.">
                            <div class="text-muted mb-2">
                                Cette action va supprimer la clé d'instance configurée ainsi que la clé API par défaut utilisée par ODashboard pour communiquer avec cette base Odoo. Vous devrez reconfigurer la connexion pour réutiliser ODashboard.
                            </div>
                            <button name="action_odashboard_disconnect"
                                    string="Déconnecter"
                                    type="object"
                                    class="btn-danger"
                                    confirm="Êtes-vous sûr de vouloir déconnecter ODashboard ? La clé API par défaut sera supprimée."
                                    invisible="not odashboard_instance_key"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
