<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odashboard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odashboard
        </field>
        <field name="model">res.config.settings</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="O'Dashboard"
                     string="O'Dashboard" data-key="odashboard">
                    <h2>O'Dashboard Connection</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="odashboard_instance_key"/>
                                <div class="text-muted">
                                    Copy it from your O'Dashboard instance
                                    settings
                                </div>
                                <div class="mt8">
                                    <field name="odashboard_instance_key"
                                           password="True"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Connection Status
                                </span>
                                <field name="odashboard_api_url"
                                       attrs="{'invisible': True}"/>
                                <field name="odashboard_instance_key"
                                       attrs="{'invisible': True}"/>
                                <div class="mt8">
                                    <field name="odashboard_sync_status"
                                           widget="badge"
                                           decoration-success="odashboard_sync_status == 'connected'"
                                           decoration-warning="odashboard_sync_status == 'pending'"
                                           decoration-muted="odashboard_sync_status == 'not_configured'"
                                           attrs="{'readonly': True}"/>
                                    <button name="action_odashboard_sync"
                                            string="Synchronize"
                                            type="object"
                                            noSaveDialog="true"
                                            class="btn-primary ms-2"
                                            attrs="{'invisible': ['|', ('odashboard_api_url', '=', False), ('odashboard_instance_key', '=', False)]}"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2 attrs="{'invisible': ['&amp;', ('odashboard_instance_key', '=', False), ('odashboard_sync_status', '=', 'not_configured')]}">
                        Danger Zone
                    </h2>
                    <div class="row mt16 o_settings_container"
                         attrs="{'invisible': ['&amp;', ('odashboard_instance_key', '=', False), ('odashboard_sync_status', '=', 'not_configured')]}">
                        <div class="col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Disconnect
                                    O'Dashboard
                                </span>
                                <div class="text-muted">
                                    Removes the instance key and the default
                                    API key. The connection with O'Dashboard
                                    will be interrupted.
                                </div>
                                <div class="text-muted mb-2 mt8">
                                    This action will remove the configured
                                    instance key and the default API key used
                                    by O'Dashboard to communicate with this
                                    Odoo database. You will need to reconfigure
                                    the connection to use O'Dashboard again.
                                </div>
                                <button name="action_odashboard_disconnect"
                                        string="Disconnect"
                                        type="object"
                                        class="btn-danger"
                                        confirm="Are you sure you want to disconnect O'Dashboard? The default API key will be deleted."
                                        attrs="{'invisible': [('odashboard_instance_key', '=', False)]}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
